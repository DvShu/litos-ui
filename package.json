{
  "name": "litos-ui",
  "version": "0.21.0",
  "description": "A framework-agnostic UI component library built with native Web Components and TypeScript, featuring customizable themes and dark mode.",
  "keywords": [
    "component-library",
    "css-variables",
    "custom-elements",
    "dark-mode",
    "litos-ui",
    "shadow-dom",
    "theming",
    "typescript",
    "ui-components",
    "web-components"
  ],
  "homepage": "https://dvshu.github.io/litos-ui/",
  "bugs": {
    "url": "https://github.com/DvShu/litos-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DvShu/litos-ui.git"
  },
  "files": [
    "lib",
    "styles",
    "types"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./styles/*": "./styles/*",
    "./lib/*": "./lib/*",
    "./types/*": "./types/*",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "docs:dev": "vitepress dev docs --force --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dts:build": "tsc -p tsconfig.build.json",
    "lib:build": "npm run build && npm run dts:build",
    "api": "node scripts/api.ts",
    "upload:server": "node scripts/upload-server.mjs",
    "prepack": "npm run lib:build",
    "lint": "oxlint --deny-warnings src scripts types vite.config.ts docs/.vitepress",
    "lint:fix": "oxlint --fix --deny-warnings src scripts types vite.config.ts docs/.vitepress",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "alien-signals": "^3.2.1",
    "qrcode-generator-es": "^2.1.3",
    "utilane": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "iconify-icon": "^3.0.2",
    "less": "^4.9.0",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "preact": "^10.29.8",
    "shiki": "^4.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4"
  },
  "packageManager": "pnpm@12.5.1"
}